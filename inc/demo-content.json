			"columns": [
				{
					"heading": "WordPress Bootstrap Theme",
					"image": { "src": "https://visionquestdevelopment.com/wp-content/uploads/2025/06/pegasus.png", "class": "w-50 mb-3 img-fluid", "alt": "" },
					"lead": "Free for the Community",
					"body": "When creating custom themes for clients at various jobs, I ended up doing the same thing repeatedly. Therefore, I decided to build a theme that I could always use as a base for my clients' websites and then build upon. This is a custom Bootstrap Theme for WordPress made with CMB2 and various JS libraries."
				},
				{
					"heading": "Pegasus Suite of Plugins",
					"image": { "src": "https://visionquestdevelopment.com/wp-content/uploads/2025/06/raw5.png", "class": "w-50 mb-3 img-fluid", "alt": "" },
					"lead": "It comes with a suite of plugins that are separately installed to add functionality to a site.",
					"body": "WordPress theme for free based on Twitter Bootstrap 5 for front-end markup, CMB2 for theme settings and custom fields, and Woocommerce for online shopping. I developed it to help my build process for custom bootstrap themes, and I want to put it out there for free for the open-source community and the WordPress community. Made with love from ",
					"body_link": { "text": "http://visionquestdevelopment.com", "url": "http://visionquestdevelopment.com", "target": "_blank", "suffix": "." }
				}
			],
			"install": {
				"intro": "Installation can be done by running the following code in the terminal while in the wp-content/themes directory:",
				"commands": [
					{ "label": "HTTPS", "language": "javascript", "content": "git clone https://github.com/Visionquest-Development/pegasus.git pegasus" },
